    "raw_content": "The bug is clear: `handle_payment_webhook` does not check if the webhook has already been processed before executing the payment logic. This leads to double-processing when concurrent requests arrive with the same `webhook_id`.\n\nThe fix is to:\n1. Check `webhook_repo.is_processed(webhook_id)` at the start of the function.\n2. If already processed, return early (idempotent behavior).\n3. Use the existing `_lock_for` mechanism to ensure thread-safety for the entire critical section, preventing race conditions between the check and the processing.\n\nLet's implement the fix in `service/payment_service.py`.\n\n<arch_final>\n{\"patch\": \"--- a/service/payment_service.py\\n+++ b/service/payment_service.py\\n@@ -22,6 +22,10 @@ def _lock_for(key: str) -> threading.Lock:\\n \\n \\n def handle_payment_webhook(payload: dict[str, Any]) -> dict[str, Any]:\\n+    \\\"\\\"\\\"Process payment.succeeded webhook.\\\"\\\"\\\"\\n+    webhook_id = payload[\\\"webhook_id\\\"]\\n+    if webhook_repo.is_processed(webhook_id):\\n+        return {\\\"status\\\": \\\"ok\\\", \\\"webhook_id\\\": webhook_id}\\n     \\\"\\\"\\\"Process payment.succeeded webhook.\\\"\\\"\\\"\\n     webhook_id = payload[\\\"webhook_id\\\"]\\n     tenant_id = payload[\\\"tenant_id\\\"]\\n@@ -30,6 +34,10 @@ def handle_payment_webhook(payload: dict[str, Any]) -> dict[str, Any]:\\n \\n     set_tenant(TenantContext(tenant_id=tenant_id))\\n     pay = {\\n+        \\\"id\\\": str(uuid.uuid4()),\\n+        \\\"tenant_id\\\": tenant_id,\\n+        \\\"invoice_id\\\": invoice_id,\\n+        \\\"amount_cents\\\": amount_cents,\\n+        \\\"webhook_id\\\": webhook_id,\\n+    }\\n+    payment_repo.upsert(pay)\\n+    invoice_service.mark_paid(invoice_id)\\n+    inv = invoice_repo.get(invoice_id) or {}\\n+    account_id = inv.get(\\\"account_id\\\") or payload.get(\\\"account_id\\\")\\n+    if account_id:\\n+        entitlement_service.activate_paid_plan(account_id, tenant_id)\\n+    outbox.insert(events.invoice_paid(tenant_id, invoice_id, pay[\\\"id\\\"]))\\n+    webhook_repo.mark_processed(webhook_id, {\\\"payment_id\\\": pay[\\\"id\\\"]})\\n+    return {\\\"status\\\": \\\"ok\\\", \\\"payment_id\\\": pay[\\\"id\\\"], \\\"webhook_id\\\": webhook_id}\\n+\\n+\\n+def record_payment(invoice_id: str, amount_cents: int) -> dict[str, Any]:\\n+    ctx = require_tenant()\\n+    pay = {\\n+        \\\"id\\\": str(uuid.uuid4()),\\n+        \\\"tenant_id\\\": ctx.tenant_id,\\n+        \\\"invoice_id\\\": invoice_id,\\n+        \\\"amount_cents\\\": amount_cents,\\n+    }\\n+    return payment_repo.upsert(pay)\\n\"}\n</arch_final>"
