    "task": "redesign_webhook_idempotency",
    "title": "Constrained fix: webhook idempotency",
    "family": "redesign",
    "ok": true,
    "score": 10,
    "max_score": 10,
    "grade_detail": "files=['service/payment_service.py']; evidence(reads) 1/1",
    "answer": {
      "touch_files": [
        "service/payment_service.py"
      ],
      "plan_steps": [
        "Move the _mark_processed(webhook_id) call to immediately after the idempotency check.",
        "This ensures the webhook ID is recorded as processed before any side effects (DB writes, outbox inserts) occur.",
        "If the service crashes or retries, the idempotency check will catch it and return 'duplicate', preventing double-insertion of OrderPaid events."
      ],
      "idempotency_change": "Move _mark_processed() from after the business logic to before it, right after the _already_processed() check.",
      "citations": [
        "service/payment_service.py:handle_payment_webhook",
        "service/payment_service.py:_mark_processed",
        "service/payment_service.py:_already_processed"
      ],
      "patch": "--- a/service/payment_service.py\n+++ b/service/payment_service.py\n@@ -25,6 +25,7 @@ def handle_payment_webhook(payload: dict[str, Any]) -> dict[str, Any]:\n     if _already_processed(webhook_id):\n         return {\"status\": \"duplicate\", \"order_id\": order_id}\n \n+    _mark_processed(webhook_id)\n     db.put(\n         \"payments\",\n         payment_id,\n@@ -40,5 +41,4 @@ def handle_payment_webhook(payload: dict[str, Any]) -> dict[str, Any]:\n     outbox.insert(order_paid(order_id, tenant.tenant_id, payment_id))\n     order_service.mark_paid(order_id, payment_id)\n \n-    _mark_processed(webhook_id)\n     return {\"status\": \"ok\", \"order_id\": order_id, \"payment_id\": payment_id}"
    },
