    "grade_detail": "files=['service/payment_service.py']; evidence(reads) 1/1",
    "answer": {
      "touch_files": [
        "service/payment_service.py"
      ],
      "plan_steps": [
        "Move the `_mark_processed(webhook_id)` call to immediately after the `_already_processed` check in `handle_payment_webhook`.",
        "This ensures the webhook ID is marked as processed before any side effects (payment insert, outbox event, order update) occur.",
        "If a retry occurs, the check will catch it and return early, preventing double inserts."
      ],
      "idempotency_change": "Move `_mark_processed` before `db.put`, `outbox.insert`, and `order_service.mark_paid`.",
